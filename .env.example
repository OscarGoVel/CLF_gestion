# ── CLF Gestion Web — Configuracion de produccion ────────────────────────────
# Copia este archivo como .env y completa los valores antes de arrancar.

# OBLIGATORIO en produccion: clave secreta para firmar tokens JWT.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
CLF_SECRET_KEY=cambia-esto-por-una-clave-segura

# Entorno: development | production
CLF_ENV=production

# Red
CLF_HOST=0.0.0.0
CLF_PORT=8000
CLF_HTTPS_PORT=8443

# SSL (rutas relativas a la raiz del proyecto)
CLF_SSL_CERT=ssl/server.crt
CLF_SSL_KEY=ssl/server.key
