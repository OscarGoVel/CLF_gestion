# ── CLF Gestion Web — Configuracion de produccion ────────────────────────────
# Copia este archivo como .env y completa los valores antes de arrancar.

# OBLIGATORIO en produccion: clave secreta para firmar tokens JWT.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
CLF_SECRET_KEY=cambia-esto-por-una-clave-segura

# Entorno: development | production
CLF_ENV=production

# Red
CLF_HOST=0.0.0.0
CLF_PORT=8000
CLF_HTTPS_PORT=8443

# SSL (rutas relativas a la raiz del proyecto)
CLF_SSL_CERT=ssl/server.crt
CLF_SSL_KEY=ssl/server.key

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# En local estas variables son opcionales si config.json existe.
# En produccion (Cloud Run) son OBLIGATORIAS — config.json no se sube al repo.

# Contrasena de PostgreSQL
CLF_PG_PASSWORD=cambia-esto

# Usuario y host de PostgreSQL
CLF_PG_USER=postgres
CLF_PG_HOST=localhost
CLF_PG_PORT=5432

# Base de datos de usuarios
CLF_PG_DB_USUARIOS=clf_usuarios

# ── Cloud SQL (solo en Cloud Run / GCP) ───────────────────────────────────────
# Si se define, el backend usa Unix socket en lugar de TCP.
# Formato: <proyecto>:<region>:<instancia>   Ejemplo: mi-proyecto:us-central1:clf-pg
# CLF_CLOUD_SQL_INSTANCE=

# ── Empresas (alternativa a config.json en produccion) ────────────────────────
# JSON con la lista de empresas. Si se define, reemplaza la seccion "empresas"
# de config.json. Util para Cloud Run donde no hay archivo de configuracion.
# Ejemplo (en una sola linea):
# CLF_EMPRESAS_JSON=[{"id":"emp_CLF240418U94_default","nombre":"CLF","rfc":"CLF240418U94","razon_social":"Comercializadora, Logistica y Fuerza Yucateca","pg_database":"clf_empresa","fecha_registro":"2024-01-01"}]
# CLF_EMPRESAS_JSON=
